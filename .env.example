# Appwrite Configuration
# Copy this file to .env and fill in your actual values

APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_PROJECT_NAME=your_project_name_here
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite Storage Buckets
# Note: Using a single bucket for all attachments (chat + announcements)
# due to Appwrite free tier limitation of 1 bucket
APPWRITE_CHAT_ATTACHMENTS_BUCKET_ID=chat_attachments
